---
import Layout from '../layouts/Layout.astro';
import {getCollection} from 'astro:content';
import {path} from '../lib/paths';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.date.localeCompare(a.data.date));
---
<Layout><section class="hero"><div><div class="eyebrow">KIM HYUNGYUN / ENGINEERING NOTES</div><h1>데이터베이스의 안쪽을<br/>이해하고 기록합니다.</h1><p class="muted">운영에서 마주한 질문을 실행계획과 지표로 풀어갑니다.<br/>Database · Cloud · Performance · Troubleshooting</p><a class="button" href={path('blog/')}>기술 기록 읽기 ↗</a><a class="button secondary" href={path('projects/')}>프로젝트 보기</a></div><aside class="terminal" aria-label="관심 기술"><div class="muted">~/hyungyun/database-notes</div><hr/><div>$ cat focus.txt</div><p>01 &nbsp; SQL & Execution Plan<br/>02 &nbsp; Aurora & RDS<br/>03 &nbsp; Migration & Upgrade<br/>04 &nbsp; PostgreSQL Internals</p><hr/><div class="muted">배우고 → 검증하고 → 공유하기 _</div></aside></section><div class="sectionhead"><h2>기술 기록 <span class="meta">{posts.length} POSTS</span></h2><a href={path('blog/')}>전체 글 →</a></div>{posts.slice(0,5).map(p=><article class="row"><div class="meta">{p.data.date.slice(0,10)}</div><div><div class="meta">{p.data.category}</div><h3><a href={path(`blog/${p.id}/`)}>{p.data.title}</a></h3><p class="muted">{p.data.description}</p></div></article>)}<div class="sectionhead"><h2>실무를 설명하는 포트폴리오</h2></div><div class="grid">{['Migration & Upgrade','Performance & Troubleshooting'].map(t=><a class="card" href={path('projects/')}><div class="eyebrow">PROJECT NOTES</div><h3>{t} ↗</h3><p class="muted">배경, 담당 역할, 분석 근거와 검증 과정을 중심으로 정리합니다.</p></a>)}</div></Layout>
