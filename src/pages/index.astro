---
import Layout from '../layouts/Layout.astro';
import {projects} from '../data/projects';
import {getCollection} from 'astro:content';
import {path} from '../lib/paths';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.date.localeCompare(a.data.date));
---
<Layout><section class="hero"><div><div class="eyebrow">KIM HYUNGYUN / PERSONAL NOTES</div><h1 class="home-title">꼼꼼하게 확인하고<br/>기록하는 개인 기록장입니다.</h1><p class="muted">일하며 겪은 데이터베이스 이슈와 개인 공부 기록을 담았습니다.</p><a class="button" href={path('blog/')}>기록장 둘러보기 ↗</a><a class="button secondary" href={path('projects/')}>프로젝트 보기</a></div><aside class="terminal" aria-label="관심 기술"><div class="muted">~/hyungyun/database-notes</div><hr/><div>$ cat focus.txt</div><p>01 &nbsp; SQL & Execution Plan<br/>02 &nbsp; Aurora & RDS<br/>03 &nbsp; Migration & Upgrade<br/>04 &nbsp; PostgreSQL Internals</p><hr/><div class="muted">DB 운영 이슈 · 개인 학습 기록</div></aside></section><div class="sectionhead recent-heading"><h2>최근 기술 기록 <span class="meta">RECENTLY · 5 POSTS</span></h2><a href={path('blog/')}>전체 글 →</a></div>{posts.slice(0,5).map(p=><article class="row recent-post"><div class="meta">{p.data.date.slice(0,10)}</div><div><div class="meta">{p.data.category}</div><h3><a href={path(`blog/${p.id}/`)}>{p.data.title}</a></h3><p class="muted">{p.data.description}</p></div></article>)}<div class="sectionhead"><h2>함께 해온 일들</h2></div><div class="grid">{projects.slice(0,2).map(p=><a class="card" href={path(`projects/${p.id}/`)}><div class="eyebrow">{p.area}</div><h3>{p.title} ↗</h3><p class="muted">{p.summary}</p><span class="meta">{p.period}</span></a>)}</div></Layout>

<style>
  .hero > div {
    container-type: inline-size;
  }

  .home-title {
    font-size: clamp(26px, 7cqi, 54px);
    word-break: keep-all;
    text-wrap: balance;
  }
</style>
