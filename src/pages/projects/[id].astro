---
import Layout from '../../layouts/Layout.astro';import {projects} from '../../data/projects';import {getCollection} from 'astro:content';import{path}from '../../lib/paths';
export function getStaticPaths(){return projects.map(project=>({params:{id:project.id},props:{project}}));}
const {project:p}=Astro.props;
const {relatedPosts}=await import('../../lib/related-posts.mjs');
const posts=relatedPosts(p,await getCollection('blog'));
---
<Layout title={`${p.title} · 김형윤`} description={p.summary}><article class="prose project-detail"><a class="backlink" href={path('projects/')}>← 프로젝트 목록</a><div class="pagehead"><div class="eyebrow">{p.area}</div><h1>{p.title}</h1><p class="lead muted">{p.summary}</p><div class="tags">{p.tags.map(t=><span class="tag">{t}</span>)}</div></div><dl class="project-facts"><div><dt>기간</dt><dd>{p.period}</dd></div><div><dt>소속 / 유형</dt><dd>{p.company} · {p.type}</dd></div><div><dt>담당 역할</dt><dd>{p.role}</dd></div></dl><h2>어떤 일이었나요?</h2><p>{p.background}</p><h2>제가 맡은 일</h2><ul>{p.actions.map(x=><li>{x}</li>)}</ul><h2>결과</h2><ul>{p.results.map(x=><li>{x}</li>)}</ul>{'metrics' in p&&p.metrics&&<table><thead><tr><th>항목</th><th>Before</th><th>After</th></tr></thead><tbody>{p.metrics.map(r=><tr>{r.map(c=><td>{c}</td>)}</tr>)}</tbody></table>}<h2>돌아보며</h2><p>{p.focus}</p>{posts.length>0&&<section><h2>함께 읽는 기록</h2><p class="muted small">프로젝트와 관련된 주제를 공부하며 남긴 글입니다.</p>{posts.map(x=><div class="related-post"><a href={path(`blog/${x.id}/`)}>{x.data.title} →</a></div>)}</section>}<div class="source-note">이력서와 프로젝트 포트폴리오를 바탕으로 정리했습니다. <a href={p.source}>원문 보기 ↗</a></div><a class="button secondary" href={path('projects/')}>다른 프로젝트 보기</a></article></Layout>
