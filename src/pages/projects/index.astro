---
import Layout from '../../layouts/Layout.astro';import{projects}from '../../data/projects';import{path}from '../../lib/paths';
---
<Layout title="프로젝트 · 김형윤" description="DB 운영, SQL 튜닝, Migration과 제품 설계에 참여한 기록"><div class="pagehead"><div class="eyebrow">WORK & EXPERIENCE</div><h1>함께 해온 일들</h1><p class="muted">운영과 성능 분석, 데이터 이전을 하며 맡았던 일들을 정리했습니다.</p></div><div class="grid project-grid">{projects.map((p,i)=><a class="card project-card" href={path(`projects/${p.id}/`)}><div class="project-top"><span class="eyebrow">{p.area}</span><span class="project-number">{String(i+1).padStart(2,'0')}</span></div><h3>{p.title} ↗</h3><p class="muted">{p.summary}</p><div class="tags">{p.tags.slice(0,4).map(t=><span class="tag">{t}</span>)}</div><div class="project-bottom"><span>{p.period}</span><span>{p.type}</span></div></a>)}</div></Layout>
